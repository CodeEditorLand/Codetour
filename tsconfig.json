{
	"compilerOptions": {
		"baseUrl": "./",
		"lib": [
			"ES2019",
			"DOM"
		],
		"module": "commonjs",
		"noUnusedLocals": true,
		"outDir": "Target",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "es6"
	},
	"exclude": [
		"node_modules"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src"
	]
}
